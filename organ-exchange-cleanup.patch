+"""Simplified organ exchange optimizer.
+
+This module solves a coursework version of kidney exchange: given a directed
+compatibility graph, select a maximum-size set of disjoint 2-cycles and
+3-cycles.
+"""
+
+import random
+import time
+
+import networkx as nx
+import pulp
+
+
+def find_organ_exchange(g):
+    """Return a maximum-size set of disjoint exchange cycles.
+
+    Args:
+        g (networkx.DiGraph): Directed compatibility graph. Nodes are
+            patient-donor pairs. An edge ``u -> v`` means the donor from pair
+            ``u`` can donate to the patient from pair ``v``.
+
+    Returns:
+        tuple[list[list], int]: A pair ``(cycles, total_transplants)`` where
+        ``cycles`` contains selected cycles of length 2 or 3, and
+        ``total_transplants`` is the number of participating pairs.
+    """
+    cycles = []
+    seen = set()
+
+    # 2-cycles: u -> v and v -> u.
+    for u, v in g.edges():
+        if u == v:
+            continue
+        if g.has_edge(v, u):
+            cycle_key = tuple(sorted([u, v]))
+            if cycle_key not in seen:
+                seen.add(cycle_key)
+                cycles.append([u, v])
+
+    # 3-cycles: u -> v -> w -> u.
+    for u in g.nodes():
+        for v in g.successors(u):
+            if v == u:
+                continue
+            for w in g.successors(v):
+                if w == u or w == v:
+                    continue
+                if g.has_edge(w, u):
+                    cycle_key = tuple(sorted([u, v, w]))
+                    if cycle_key not in seen:
+                        seen.add(cycle_key)
+                        cycles.append([u, v, w])
+
+    prob = pulp.LpProblem("organ_exchange", pulp.LpMaximize)
+
+    # x[i] = 1 if cycle i is selected.
+    x = {
+        i: pulp.LpVariable(f"x{i}", cat="Binary")
+        for i in range(len(cycles))
+    }
+
+    # Maximize the number of matched patient-donor pairs.
+    prob += pulp.lpSum(len(cycles[i]) * x[i] for i in range(len(cycles)))
+
+    # Each pair may participate in at most one selected cycle.
+    for node in g.nodes():
+        relevant_cycles = [i for i, cycle in enumerate(cycles) if node in cycle]
+        if relevant_cycles:
+            prob += pulp.lpSum(x[i] for i in relevant_cycles) <= 1
+
+    status = prob.solve(pulp.PULP_CBC_CMD(msg=0))
+    if pulp.LpStatus[status] != "Optimal":
+        raise RuntimeError(f"ILP solver did not find an optimal solution: {pulp.LpStatus[status]}")
+
+    selected_cycles = []
+    total_transplants = 0
+    for i, cycle in enumerate(cycles):
+        if pulp.value(x[i]) and pulp.value(x[i]) > 0.5:
+            selected_cycles.append(cycle)
+            total_transplants += len(cycle)
+
+    return selected_cycles, total_transplants
+
+
+def generate_random_graph(n, p, seed=None):
+    """Generate a random directed graph for examples and tests."""
+    rng = random.Random(seed) if seed is not None else random
+    g = nx.DiGraph()
+    g.add_nodes_from(range(n))
+
+    for i in range(n):
+        for j in range(n):
+            if i != j and rng.random() < p:
+                g.add_edge(i, j)
+
+    return g
+
+
+def _run_basic_example():
