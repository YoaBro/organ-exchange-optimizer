+"""Unit tests for the organ exchange optimizer."""
+
+import unittest
+
+import networkx as nx
+
+from organ_exchange_optimizer import find_organ_exchange, generate_random_graph
+
+
+class TestOrganExchangeOptimizer(unittest.TestCase):
+    def test_simple_2_cycle(self):
+        g = nx.DiGraph()
+        g.add_edge(0, 1)
+        g.add_edge(1, 0)
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 2)
+        self.assertEqual(len(cycles), 1)
+        self.assertIn([0, 1], cycles)
+
+    def test_simple_3_cycle(self):
+        g = nx.DiGraph()
+        g.add_edge(0, 1)
+        g.add_edge(1, 2)
+        g.add_edge(2, 0)
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 3)
+        self.assertEqual(len(cycles), 1)
+
+    def test_multiple_disjoint_cycles(self):
+        g = nx.DiGraph()
+        g.add_edge(0, 1)
+        g.add_edge(1, 0)
+        g.add_edge(2, 3)
+        g.add_edge(3, 2)
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 4)
+        self.assertEqual(len(cycles), 2)
+
+    def test_no_cycles(self):
+        g = nx.DiGraph()
+        g.add_edge(0, 1)
+        g.add_edge(1, 2)
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 0)
+        self.assertEqual(cycles, [])
+
+    def test_complex_case(self):
+        g = nx.DiGraph()
+        g.add_edge(0, 1)
+        g.add_edge(1, 0)
+        g.add_edge(2, 3)
+        g.add_edge(3, 4)
+        g.add_edge(4, 2)
+        g.add_edge(1, 2)
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 5)
+        self.assertEqual(len(cycles), 2)
+
+    def test_self_loop_is_not_counted_as_exchange(self):
+        g = nx.DiGraph()
+        g.add_edge(0, 0)
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 0)
+        self.assertEqual(cycles, [])
+
+    def test_generate_random_graph(self):
+        g = generate_random_graph(n=10, p=0.5, seed=1)
+
+        self.assertEqual(g.number_of_nodes(), 10)
+        self.assertIsInstance(g, nx.DiGraph)
+        self.assertFalse(any(u == v for u, v in g.edges()))
+
+    def test_single_node(self):
+        g = nx.DiGraph()
+        g.add_node(0)
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 0)
+        self.assertEqual(cycles, [])
+
+    def test_empty_graph(self):
+        g = nx.DiGraph()
+
+        cycles, total = find_organ_exchange(g)
+
+        self.assertEqual(total, 0)
+        self.assertEqual(cycles, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
