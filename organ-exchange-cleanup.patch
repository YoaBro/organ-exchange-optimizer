+    g.add_edge(0, 1)
+    g.add_edge(1, 0)
+
+    # 3-cycle: 2 -> 3 -> 4 -> 2.
+    g.add_edge(2, 3)
+    g.add_edge(3, 4)
+    g.add_edge(4, 2)
+
+    # Extra edge that does not create a better solution.
+    g.add_edge(1, 2)
+
+    cycles, total = find_organ_exchange(g)
+    print(f"transplants: {total}")
+    print("cycles found:")
+    for cycle in cycles:
+        print("  ", cycle)
+
+
+def _run_random_benchmark():
+    print("\n=== Random graph benchmark ===")
+
+    edge_prob = 0.3
+    max_n_under_one_minute = 0
+
+    for n in [10, 20, 30, 50, 75, 100, 150, 200, 250, 300, 400, 500]:
+        g = generate_random_graph(n, edge_prob, seed=n)
+
+        start = time.time()
+        cycles, total = find_organ_exchange(g)
+        elapsed = time.time() - start
+
+        print(f"n={n}: {total} transplants, {len(cycles)} cycles, time={elapsed:.2f}s")
+
+        if elapsed <= 60:
+            max_n_under_one_minute = n
+        else:
+            print(f"exceeded 60 seconds at n={n}")
+            break
+
+    print(f"\nlargest n that finished in under 1 minute: {max_n_under_one_minute}")
+
+
+if __name__ == "__main__":
+    _run_basic_example()
+    _run_random_benchmark()
